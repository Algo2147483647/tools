{
  "name": "json-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Single text editor with an AI console and Python JSON, YAML and text engine",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/python.mjs server.py",
    "dev": "node scripts/python.mjs server.py",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/python.mjs server.py --dist",
    "test": "node scripts/python.mjs -m unittest discover -s tests -p test_*.py -v",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.7"
  }
}
