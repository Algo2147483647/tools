# Commands for the PX4 SITL shell. Simulation only; do not apply to real hardware.
# AETR with arm switch on channel 5 and flight-mode switch on channel 6.
param set RC_MAP_ROLL 1
param set RC_MAP_PITCH 2
param set RC_MAP_THROTTLE 3
param set RC_MAP_YAW 4
param set RC_MAP_ARM_SW 5
param set RC_MAP_FLTMODE 6
param set RC1_MIN 1000
param set RC1_MAX 2000
param set RC1_TRIM 1500
param set RC2_MIN 1000
param set RC2_MAX 2000
param set RC2_TRIM 1500
param set RC3_MIN 1000
param set RC3_MAX 2000
param set RC3_TRIM 1000
param set RC4_MIN 1000
param set RC4_MAX 2000
param set RC4_TRIM 1500
# Channel 6 low selects Acro; high selects Stabilized (the UI Angle option).
param set COM_FLTMODE1 5
param set COM_FLTMODE6 7
param save
