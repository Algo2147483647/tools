# FlightLab simulation-only configuration for Betaflight 4.5.2 Quad X.
# Apply to SITL UART1 TCP 5761 using the Betaflight Configurator CLI.
# Do not apply to a physical aircraft.
mixer QUADX
map AETR1234
set motor_pwm_protocol = PWM
set pid_process_denom = 1
set min_command = 1000
set min_throttle = 1000
set max_throttle = 2000
set small_angle = 180
aux 0 0 0 1700 2100 0 0
aux 1 1 1 1700 2100 0 0
save
