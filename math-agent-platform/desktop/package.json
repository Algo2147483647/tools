{
  "name": "math-agent-desktop",
  "version": "0.10.0",
  "private": true,
  "description": "AI mathematics workspace with symbolic, numerical, plotting and data tools",
  "author": "Math Agent Platform",
  "main": "build/backend/main.js",
  "scripts": {
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test",
    "build": "node ../scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test platform/*.test.cjs ai/*.test.cjs renderer/*.test.cjs tools/*.test.cjs application/*.test.cjs",
    "pack": "npm run verify && electron-builder --dir",
    "dist:win": "npm run verify && electron-builder --win nsis",
    "dist:mac": "npm run verify && electron-builder --mac dmg",
    "check:runtime": "node ../scripts/check.cjs"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-texmath": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ajv": "8.17.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-win32-x64": "^7.0.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch@>=7": "11.0.1"
  },
  "build": {
    "appId": "local.mathagent.workspace",
    "productName": "Math Agent",
    "files": [
      "build/backend/**/*.js",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/editor.bundle.js",
      "renderer/editor.bundle.css",
      "renderer/app.bundle.js",
      "renderer/fonts/**/*",
      "engine/lean-lock.json"
    ],
    "directories": {
      "output": "dist-math"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "../.runtime/python-engine",
        "to": "math-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "engine",
        "to": "math-engine",
        "filter": [
          "code_worker.py"
        ]
      },
      {
        "from": "../.runtime/lean-runtime",
        "to": "lean-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../engines/mathematics",
        "to": "mathematics",
        "filter": [
          "worker.py",
          "src/**/*",
          "pyproject.toml",
          "runtime-lock.json",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.egg-info/**"
        ]
      }
    ]
  }
}
