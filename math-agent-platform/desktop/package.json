{
  "name": "math-agent-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "AI mathematics workspace with symbolic, numerical, plotting and data tools",
  "author": "Math Agent Platform",
  "main": "main.cjs",
  "scripts": {
    "check": "node ../scripts/check.cjs",
    "verify": "npm run check && npm test && npm run build",
    "build": "esbuild renderer/editor.js --bundle --outfile=renderer/editor.bundle.js --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name]-[hash]",
    "start": "npm run build && electron .",
    "test": "node --test ai/*.test.cjs renderer/*.test.cjs tools/*.test.cjs",
    "pack": "npm run verify && electron-builder --dir",
    "dist:win": "npm run verify && electron-builder --win nsis",
    "dist:mac": "npm run verify && electron-builder --mac dmg"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-texmath": "^1.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch@>=7": "11.0.1"
  },
  "build": {
    "appId": "local.mathagent.workspace",
    "productName": "Math Agent",
    "files": [
      "main.cjs",
      "preload.cjs",
      "application/**/*.cjs",
      "core/**/*.cjs",
      "ai/**/*.cjs",
      "!**/*.test.cjs",
      "renderer/index.html",
      "renderer/app.js",
      "renderer/state.js",
      "renderer/style.css",
      "renderer/editor.bundle.js",
      "renderer/editor.bundle.css",
      "renderer/fonts/**/*",
      "tools/**/*.cjs",
      "!tools/**/*.test.cjs"
    ],
    "directories": {
      "output": "dist-math"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "../.runtime/python-engine",
        "to": "math-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "engine",
        "to": "math-engine",
        "filter": [
          "math_worker.py",
          "runtime-lock.json"
        ]
      }
    ]
  }
}
