  "tools": [
    {
      "name": "exact_math",
      "version": "2.0.0",
      "operation": "evaluate",
      "timeoutMs": 30000,
      "description": "Exact rational arithmetic and one-variable linear equations. Supports implicit multiplication. Rational constants support integer powers with ^ or **, including negative exponents (absolute exponent <=4096). Powers bind before unary minus and associate right. Zero to zero/negative powers, fractional/variable exponents and nonlinear variable powers are rejected. No variable denominators. Independently checks substitution and affine conditions.",
      "parameters": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "expression"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "symbolic_math",
      "version": "1.0.0",
      "operations": [
        "simplify",
        "expand",
        "factor",
        "solve",
        "differentiate",
        "integrate",
        "limit"
      ],
      "timeoutMs": 30000,
      "description": "Symbolic algebra/calculus using SymPy. Explicit multiplication; powers use ^ or **. Operations: simplify, expand, factor, solve ONE variable equation, differentiate, integrate (optional finite interval), limit. Declare real/complex domain. Does not execute code. Exact integration endpoints accept strings such as 1/3 or pi; use strings to preserve decimal precision.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "simplify",
              "expand",
              "factor",
              "solve",
              "differentiate",
              "integrate",
              "limit"
            ]
          },
          "expression": {
            "type": "string",
            "maxLength": 4096
          },
          "variable": {
            "type": "string",
            "maxLength": 24
          },
          "interval": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              ]
            },
            "maxItems": 2,
            "minItems": 2
          },
          "domain": {
            "type": "string",
            "enum": [
              "real",
              "complex"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "point": {
            "type": "string",
            "maxLength": 100
          },
          "direction": {
            "type": "string",
            "enum": [
              "+",
              "-",
              "+-"
            ]
          }
        },
        "required": [
          "operation",
          "expression"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "numeric_math",
      "version": "1.0.0",
      "operations": [
        "root",
        "integrate",
        "minimize",
        "linear_solve",
        "eigenvalues"
      ],
      "timeoutMs": 30000,
      "description": "Floating-point numerical calculation. root requires a continuous function with a sign-changing interval; integrate uses finite bounds; minimize is bounded LOCAL minimization, not a global proof. linear_solve needs square matrix and vector; eigenvalues needs square matrix. Explicit multiplication. Precision specifies absolute/relative tolerances and iteration budget; mutually exclusive with tolerance. Only standard binary64 is currently supported; requested tolerances are not certified error bounds.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "root",
              "integrate",
              "minimize",
              "linear_solve",
              "eigenvalues"
            ]
          },
          "expression": {
            "type": "string",
            "maxLength": 4096
          },
          "variable": {
            "type": "string",
            "maxLength": 24
          },
          "interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "tolerance": {
            "type": "number",
            "minimum": 1e-12,
            "maximum": 0.01
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "maxItems": 50,
              "minItems": 1
            },
            "maxItems": 50,
            "minItems": 1
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 50,
            "minItems": 1
          },
          "precision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "standard",
                  "high_precision",
                  "certified"
                ]
              },
              "absoluteTolerance": {
                "type": "number",
                "minimum": 1e-14,
                "maximum": 0.01
              },
              "relativeTolerance": {
                "type": "number",
                "minimum": 1e-14,
                "maximum": 0.01
              },
              "workingDigits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "maxDigits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "maxIterations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "certificationRequired": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "plot_math",
      "version": "1.0.0",
      "operations": [
        "function",
        "scatter",
        "line",
        "histogram",
        "regression"
      ],
      "timeoutMs": 30000,
      "description": "Render a PNG chart directly in the answer. function: expression or expressions and interval. scatter/line/regression: attached datasetId, xColumn, yColumn. histogram: datasetId and xColumn. Missing/non-numeric rows require explicit missingPolicy=drop to exclude.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "function",
              "scatter",
              "line",
              "histogram",
              "regression"
            ]
          },
          "expression": {
            "type": "string",
            "maxLength": 4096
          },
