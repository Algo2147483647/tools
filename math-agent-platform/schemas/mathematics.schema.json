            },
            "minItems": 1,
            "maxItems": 100
          },
          "cones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matrix": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1,
