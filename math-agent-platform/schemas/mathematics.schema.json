              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "inequalityBounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "equalityMatrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
