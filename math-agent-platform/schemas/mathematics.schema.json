            "type": "integer",
            "minimum": 50,
            "maximum": 2000
          },
          "bins": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analyze_data",
      "version": "1.0.0",
      "operations": [
        "overview",
        "describe",
        "correlation",
        "regression",
        "group_by",
        "filter"
      ],
      "timeoutMs": 30000,
      "description": "Analyze an ATTACHED CSV/TSV dataset. overview reports schema/missing values. describe/correlation take numeric columns; regression takes [predictor,response]; group_by takes groupColumn, numeric columns and aggregate. filter uses typed filters. Use missingPolicy=drop only when exclusion is appropriate and disclose it. Tables appear directly in answer.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "maxLength": 80
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 40,
            "minItems": 1
          },
          "missingPolicy": {
