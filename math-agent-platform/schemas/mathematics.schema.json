            "type": "string",
            "maxLength": 24
          },
          "interval": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2
          },
          "datasetId": {
            "type": "string",
            "maxLength": 80
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 40,
            "minItems": 1
          },
          "missingPolicy": {
            "type": "string",
            "enum": [
              "reject",
              "drop"
            ]
          },
          "expressions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "maxItems": 5,
            "minItems": 1
          },
          "xColumn": {
            "type": "string",
            "maxLength": 100
          },
          "yColumn": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "samples": {
            "type": "integer",
            "minimum": 50,
            "maximum": 2000
          },
          "bins": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analyze_data",
      "version": "1.0.0",
      "operations": [
        "overview",
        "describe",
        "correlation",
        "regression",
        "group_by",
        "filter"
      ],
      "timeoutMs": 30000,
      "description": "Analyze an ATTACHED CSV/TSV dataset. overview reports schema/missing values. describe/correlation take numeric columns; regression takes [predictor,response]; group_by takes groupColumn, numeric columns and aggregate. filter uses typed filters. Use missingPolicy=drop only when exclusion is appropriate and disclose it. Tables appear directly in answer.",
      "parameters": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "maxLength": 80
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 40,
            "minItems": 1
          },
          "missingPolicy": {
            "type": "string",
            "enum": [
              "reject",
              "drop"
            ]
          },
          "groupColumn": {
            "type": "string",
            "maxLength": 100
          },
          "aggregate": {
            "type": "string",
            "enum": [
              "mean",
              "sum",
              "min",
              "max",
              "count"
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "maxLength": 100
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "ne",
                    "gt",
                    "ge",
                    "lt",
                    "le"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "column",
                "operator",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 10,
            "minItems": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "overview",
              "describe",
              "correlation",
              "regression",
              "group_by",
              "filter"
            ]
          }
        },
        "required": [
          "operation",
          "datasetId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "convex_optimize",
      "version": "1.0.0",
      "operations": [
        "linear_program",
        "quadratic_program",
        "least_squares",
        "second_order_cone"
      ],
      "timeoutMs": 30000,
      "description": "Convex optimization with CVXPY/CLARABEL. LP: minimize linear^T x. QP: minimize 0.5*x^T quadratic*x + linear^T*x; quadratic must be symmetric PSD. Least squares: minimize ||design*x-target||^2, optional linear term. Constraints: inequalityMatrix*x<=inequalityBounds, equalityMatrix*x=equalityBounds, finite lower/upper. SOC: each cone imposes ||matrix*x+offset||_2 <= axis^T*x+bound. Returns solver status, primal/dual values and feasibility residuals; numerical optimization is not a formal proof. Precision specifies absolute/relative tolerances and iteration budget; mutually exclusive with tolerance. Only standard binary64 is currently supported; requested tolerances are not certified error bounds.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "linear_program",
              "quadratic_program",
              "least_squares",
              "second_order_cone"
            ]
          },
          "linear": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "quadratic": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "design": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "target": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "inequalityMatrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "inequalityBounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "equalityMatrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "equalityBounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "lower": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "upper": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "cones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matrix": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "axis": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "bound": {
                  "type": "number"
                }
              },
              "required": [
                "matrix",
                "offset",
                "axis",
                "bound"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          },
          "tolerance": {
            "type": "number",
            "minimum": 1e-10,
            "maximum": 0.001
          },
          "precision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "standard",
                  "high_precision",
                  "certified"
                ]
              },
              "absoluteTolerance": {
                "type": "number",
                "minimum": 1e-14,
                "maximum": 0.01
              },
              "relativeTolerance": {
                "type": "number",
                "minimum": 1e-14,
                "maximum": 0.01
              },
              "workingDigits": {
