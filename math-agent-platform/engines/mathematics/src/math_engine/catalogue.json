      "type": "object",
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "format": {
          "type": "string",
          "enum": [
            "ascii",
            "latex"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "evaluate",
            "floor",
            "ceil",
            "truncate",
            "mod",
            "compare",
            "round"
          ]
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digits": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "rounding": {
          "type": "string",
          "enum": [
            "half_even",
            "half_away_from_zero"
          ]
        },
        "ir": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "expression"
          ],
          "not": {
            "required": [
              "ir"
            ]
          }
        },
        {
