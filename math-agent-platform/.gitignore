# Downloaded toolchains and dependencies
/.runtime/
node_modules/

# Generated application output and installers
/desktop/build/
/desktop/dist-math/
/desktop/dist/
/desktop/release/
/desktop/renderer/fonts/
/desktop/renderer/*.bundle.js
/desktop/renderer/*.bundle.css
/desktop/renderer/*.bundle.js.map
/desktop/renderer/*.bundle.css.map

# Local caches and diagnostic output
.cache/
__pycache__/
*.py[cod]
*.tsbuildinfo
coverage/
.nyc_output/
test-results/
playwright-report/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local configuration and credentials (keep example templates)
.env
.env.*
!.env.example
!.env.sample
ai-settings.json

# OS/editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Commit package-lock.json, engine/*-lock.json, source fonts/assets,
# source code, tests, documentation and runtime preparation scripts.
/desktop/dist-current/

# Independent Python package build output
/engines/mathematics/build/
/engines/mathematics/dist/
*.egg-info/
