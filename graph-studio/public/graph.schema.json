{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Studio document v3",
  "description": "Runtime validation also checks unique edge IDs and directed endpoint pairs, endpoint existence, and no self-loops. Sankey diagrams additionally require finite non-negative flow values, finite node totals. Cycles are supported as return flows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "graph-studio"
    },
    "version": {
      "const": 3
    },
    "diagram": {
      "enum": [
        "dag",
        "sankey"
      ],
      "description": "Optional diagram semantics. Defaults to dag. Sankey opens in flow layout."
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "groups",
        "parentById"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              }
            }
          }
        },
        "parentById": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "diagram"
        ],
        "properties": {
          "diagram": {
            "const": "sankey"
          }
        }
      },
      "then": {
        "properties": {
          "edges": {
            "items": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^,\\r\\n]+$"
    },
    "node": {
      "type": "object",
      "properties": {
        "key": false,
        "parents": false,
        "children": false,
        "title": {
          "type": "string"
        },
        "define": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
