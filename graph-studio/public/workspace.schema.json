{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Studio workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "graphs"
  ],
  "properties": {
    "format": {
      "const": "graph-studio-workspace"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "graphs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/graphPath"
      }
    },
    "defaultGraph": {
      "$ref": "#/$defs/graphPath"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "graphPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$)(?!graph-studio\\.workspace\\.json$)[^/\\\\:?#\\u0000-\\u001f]+(?:/[^/\\\\:?#\\u0000-\\u001f]+)*\\.[jJ][sS][oO][nN]$"
    }
  },
  "description": "Paths are canonical and relative to the chosen folder. The application additionally checks defaultGraph membership, referenced file existence and graph document validity."
}
