      "css": "",
      "palette": {
        "categories": [
          [356, 58, 47],
          [214, 62, 44],
          [145, 52, 40],
          [32, 66, 47],
          [188, 54, 42],
          [265, 48, 48],
          [325, 48, 48],
          [210, 24, 44]
        ],
        "groups": [
          ["#fffdf5", "#fffbea", "#fff7df", "#fff4d5"],
          ["#f5fdf9", "#edfdf5", "#e5fbf0", "#dcf8e9"],
          ["#fff9f5", "#fff3eb", "#ffede1", "#ffe7d8"],
          ["#f5fcff", "#edf9ff", "#e4f6ff", "#daf2ff"]
        ]
      },
      "performance": {
        "denseThresholds": [220, 440, 20000000],
        "denseShadows": "disable"
      }
