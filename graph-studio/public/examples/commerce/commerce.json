{
  "format": "graph-studio",
  "version": 3,
  "id": "commerce-reference",
  "title": "Commerce: order-to-delivery and returns",
  "metadata": {
    "layout": "commerce.compound.layout.json",
    "description": "Fictional reference architecture for nested node-link exploration.",
    "relationshipSemantics": "Directed API calls, events and operational handoffs; not quantities."
  },
  "nodes": {
    "web": {
      "title": "Web storefront",
      "type": "channel",
      "define": "Customer shopping and self-service returns.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "mobile": {
      "title": "Mobile app",
      "type": "channel",
      "define": "Mobile checkout and order tracking.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "gateway": {
      "title": "Storefront API",
      "type": "service",
      "define": "Routes customer requests to domain services.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "cart": {
      "title": "Shopping cart",
      "type": "service",
      "define": "Holds proposed line items before order placement.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "pricing": {
      "title": "Pricing & promotions",
      "type": "service",
      "define": "Produces an immutable price quote.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "orders": {
      "title": "Order orchestration",
      "type": "service",
      "define": "Coordinates stock, payment and fulfillment; operations are idempotent.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "order-db": {
      "title": "Order records",
      "type": "data",
      "define": "Stores order state and correlation IDs.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "fraud": {
      "title": "Fraud screening",
      "type": "service",
      "define": "Evaluates payment risk before authorization.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "risk-rules": {
      "title": "Risk rules",
      "type": "data",
      "define": "Versioned policy input to fraud screening.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "authorize": {
      "title": "Payment authorization",
      "type": "service",
      "define": "Requests authorization from the payment partner.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "capture": {
      "title": "Payment capture",
      "type": "service",
      "define": "Captures an authorized amount after stock is reserved.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "refund": {
      "title": "Refund execution",
      "type": "service",
      "define": "Issues an idempotent refund for an approved return.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "payment-ledger": {
      "title": "Payment ledger",
      "type": "data",
      "define": "Records authorization, capture and refund outcomes.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "reserve": {
      "title": "Stock reservation",
      "type": "service",
      "define": "Reserves stock with an expiry; releases it after a failed payment.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "stock-db": {
      "title": "Stock records",
      "type": "data",
      "define": "Available, reserved and returned stock.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "pick": {
      "title": "Picking",
      "type": "operation",
      "define": "Picks reserved items after payment confirmation.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "pack": {
      "title": "Packing",
      "type": "operation",
      "define": "Checks items and prepares parcels.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "restock": {
      "title": "Return restocking",
      "type": "operation",
      "define": "Returns accepted items to available stock.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "shipment": {
      "title": "Shipment creation",
      "type": "service",
      "define": "Creates the shipment and requests a carrier label.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "dispatch": {
      "title": "Parcel dispatch",
      "type": "operation",
      "define": "Hands the parcel to the carrier.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "tracking": {
      "title": "Delivery tracking",
      "type": "service",
      "define": "Consumes carrier events and publishes delivery status.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "return-case": {
      "title": "Return request",
      "type": "service",
      "define": "Links a customer claim to the original order.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "inspection": {
      "title": "Return inspection",
      "type": "operation",
      "define": "Approves condition and eligibility before refund and restocking.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "case-db": {
      "title": "After-sales records",
      "type": "data",
      "define": "Stores case decisions and refund correlation IDs.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "events": {
      "title": "Domain event bus",
      "type": "service",
      "define": "Delivers domain events; consumers deduplicate event IDs.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "notifications": {
      "title": "Customer notifications",
      "type": "service",
      "define": "Builds order, shipment and refund messages.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "email": {
      "title": "Email delivery",
      "type": "service",
      "define": "Delivers transactional email.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "audit": {
      "title": "Audit trail",
      "type": "data",
      "define": "Receives business audit events.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "metrics": {
      "title": "Metrics & alerts",
      "type": "service",
      "define": "Receives application health metrics.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "synthetic-monitor": {
      "title": "Synthetic checkout monitor",
      "type": "operation",
      "define": "Intentionally unconnected in this business-event graph: still a member of Observability.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "bank": {
      "title": "Payment provider",
      "type": "partner",
      "define": "External authorization, capture and refund API.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
    "carrier": {
      "title": "Parcel carrier",
      "type": "partner",
      "define": "External label and tracking API.",
      "notes": "[Scenario guide](./notes/scenario.md) · [Failure and return paths](./notes/exceptions.md)"
    },
