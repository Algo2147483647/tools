{
  "name": "dag-studio-react",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --loader ts-node/esm --experimental-specifier-resolution=node src/test/core.test.ts",
    "preview": "vite preview",
    "format": "prettier --write src scripts/build-mathematics.mjs scripts/build-commerce.mjs scripts/data/mathematics package.json tsconfig.json vite.config.ts .prettierrc.json",
    "format:check": "prettier --check src scripts/build-mathematics.mjs scripts/build-commerce.mjs scripts/data/mathematics package.json tsconfig.json vite.config.ts .prettierrc.json",
    "examples:mathematics": "node scripts/build-mathematics.mjs",
    "examples:mathematics:check": "node scripts/build-mathematics.mjs --check",
    "examples:commerce": "node scripts/build-commerce.mjs",
    "examples:commerce:check": "node scripts/build-commerce.mjs --check",
    "check": "npm run format:check && npm run examples:mathematics:check && npm run examples:commerce:check && npm test && npm run build"
  },
  "dependencies": {
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-react": "^4.2.1",
    "d3-sankey": "^0.12.3",
    "dagre": "^0.8.5",
    "elkjs": "^0.12.0",
    "katex": "^0.16.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^4.5.3"
  },
  "devDependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.5",
    "prettier": "3.9.9",
    "ts-node": "^10.9.2"
  }
}
