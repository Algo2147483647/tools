{
  "name": "graph-studio",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "build": "tsc --noEmit && tsc -p server/tsconfig.json && vite build && node scripts/build-backend.mjs",
    "test": "node --loader ts-node/esm --experimental-specifier-resolution=node src/test/core.test.ts",
    "test:launcher": "node --test scripts/test/*.test.mjs",
    "clean": "node scripts/clean.mjs",
    "preview": "node scripts/launch.mjs --preview",
    "format": "prettier --write src server browser-tests scripts/**/*.mjs package.json tsconfig.json vite.config.ts .prettierrc.json",
    "format:check": "prettier --check src server browser-tests scripts/**/*.mjs package.json tsconfig.json vite.config.ts .prettierrc.json",
    "check": "npm run format:check && npm test && npm run test:server && npm run build && npm run test:launcher",
    "test:server": "node scripts/test-server.mjs"
  },
  "dependencies": {
    "d3-sankey": "^0.12.3",
    "dagre": "^0.8.5",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.16.45",
    "parse5": "^8.1.0",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/dagre": "^0.7.54",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.2.1",
    "prettier": "3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^4.5.3"
  }
}
